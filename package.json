{
  "name": "demiurges",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/studio dev",
    "dev:gateway": "bun --cwd apps/agent-gateway dev",
    "dev:offline": "bun --cwd apps/agent-gateway dev:offline",
    "generate:diagnostic-fixture": "bun scripts/generate-diagnostic-wedge-glb.mjs",
    "generate:diagnostic-splat": "bun scripts/generate-diagnostic-wedge-ply.mjs",
    "generate:smooth-vessel": "bun scripts/generate-smooth-vessel-glb.mjs",
    "import:dh013": "bun packages/world-project/src/import-dh013-cli.ts",
    "data:init": "bun packages/world-project/src/data-init-cli.ts",
    "build": "bun --cwd apps/agent-gateway build && bun --cwd apps/studio build",
    "typecheck": "bun --cwd packages/world-project typecheck && bun --cwd apps/agent-gateway typecheck && bun --cwd apps/studio typecheck && bun run typecheck:authoring",
    "test": "bun test",
    "typecheck:authoring": "tsc -p scripts/tsconfig.authoring.json"
  }
}
